---
/**
 * BeatList — renders the sorted beat catalog on /beats/.
 */
import type { ImageMetadata } from 'astro';
import { getBeats } from '../data/beats';
import BeatTrackCard from './BeatTrackCard.astro';
import lanternSlopeCover from '../assets/og/beats-lantern-slope.jpg';
import slipRoadCover from '../assets/og/beats-slip-road.jpg';
import sunsetReflectionCover from '../assets/og/beats-sunset-reflection.jpg';

const covers: Record<string, ImageMetadata> = {
  'lantern-slope': lanternSlopeCover,
  'slip-road': slipRoadCover,
  'sunset-reflection': sunsetReflectionCover,
};

const items = getBeats();
---

{
  items.length === 0 ? (
    <p>Tracks coming soon.</p>
  ) : (
    <div class="beat-list">
      {items.map((beat) => (
        <BeatTrackCard beat={beat} cover={covers[beat.slug]} />
      ))}
    </div>
  )
}

<style>
  .beat-list {
    margin-block: 1.5rem;
  }
</style>
