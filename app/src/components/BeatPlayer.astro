---
/**
 * BeatPlayer — thin custom audio player. Only one instance plays at a time.
 * Supports playback modes: once, repeat one, and queue (play all on the page).
 */
interface Props {
  src: string;
  title: string;
  slug: string;
}

const { src, title, slug } = Astro.props;
---

<div class="beat-player not-content" data-beat-player data-slug={slug}>
  <audio class="beat-audio" preload="metadata" src={src} data-beat-audio aria-label={`Audio for ${title}`}
  ></audio>

  <button type="button" class="beat-play-btn" data-beat-play aria-label={`Play ${title}`}>
    <span class="beat-play-icon" aria-hidden="true">
      <svg class="icon-play" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M9 7.5v9l7.5-4.5L9 7.5z"></path>
      </svg>
      <svg class="icon-pause" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M8 7h3v10H8V7zm5 0h3v10h-3V7z"></path>
      </svg>
    </span>
  </button>

  <input
    type="range"
    class="beat-seek"
    data-beat-seek
    min="0"
    max="1000"
    value="0"
    step="1"
    aria-label={`Seek ${title}`}
  />

  <div class="beat-time" aria-hidden="true">
    <span data-beat-current>0:00</span>
    <span class="beat-time-sep">/</span>
    <span data-beat-duration>0:00</span>
  </div>

  <button
    type="button"
    class="beat-mode-btn"
    data-beat-mode
    aria-label="Playback mode: Play once"
    title="Play once"
  >
    <span class="beat-mode-icon" aria-hidden="true">
      <!-- Play once: forward to end (no loop) -->
      <svg class="icon-mode-once" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h11"></path>
        <path d="m13 6 6 6-6 6"></path>
        <path d="M19 6v12"></path>
      </svg>
      <!-- Repeat one track -->
      <svg class="icon-mode-repeat" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m17 2 4 4-4 4"></path>
        <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
        <path d="m7 22-4-4 4-4"></path>
        <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
        <text x="12" y="14.5" text-anchor="middle" font-size="8" font-weight="700" fill="currentColor" stroke="none">1</text>
      </svg>
      <!-- Play all tracks in page order, wrapping -->
      <svg class="icon-mode-queue" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m17 2 4 4-4 4"></path>
        <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
        <path d="m7 22-4-4 4-4"></path>
        <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
      </svg>
    </span>
  </button>
</div>

<script>
  const SEEK_MAX = 1000;
  const MODE_STORAGE_KEY = 'koborin-beat-playback-mode';
  const MODES = ['once', 'repeat', 'queue'] as const;
  type PlaybackMode = (typeof MODES)[number];

  const MODE_META: Record<
    PlaybackMode,
    { label: string; title: string }
  > = {
    once: { label: 'Play once', title: 'Play once' },
    repeat: { label: 'Repeat track', title: 'Repeat this track' },
    queue: { label: 'Play all', title: 'Play all tracks in order' },
  };

  let playbackMode: PlaybackMode = 'once';

  function isPlaybackMode(value: string | null): value is PlaybackMode {
    return value === 'once' || value === 'repeat' || value === 'queue';
  }

  function loadPlaybackMode(): PlaybackMode {
    try {
      const stored = localStorage.getItem(MODE_STORAGE_KEY);
      if (isPlaybackMode(stored)) return stored;
    } catch {
      // Ignore storage access errors (private mode, etc.)
    }
    return 'once';
  }

  function savePlaybackMode(mode: PlaybackMode) {
    try {
      localStorage.setItem(MODE_STORAGE_KEY, mode);
    } catch {
      // Ignore storage access errors
    }
  }

  function formatTime(seconds: number): string {
    if (!Number.isFinite(seconds) || seconds < 0) return '0:00';
    const total = Math.floor(seconds);
    const m = Math.floor(total / 60);
    const s = total % 60;
    return `${m}:${s.toString().padStart(2, '0')}`;
  }

  function getPlayers(): HTMLElement[] {
    return Array.from(document.querySelectorAll<HTMLElement>('[data-beat-player]'));
  }

  function syncModeUi(player: HTMLElement) {
    const modeBtn = player.querySelector<HTMLButtonElement>('[data-beat-mode]');
    if (!modeBtn) return;
    const meta = MODE_META[playbackMode];
    modeBtn.dataset.mode = playbackMode;
    modeBtn.setAttribute('aria-label', `Playback mode: ${meta.label}`);
    modeBtn.setAttribute('title', meta.title);
  }

  function syncAllModeUi() {
    getPlayers().forEach(syncModeUi);
  }

  function setPlaybackMode(mode: PlaybackMode) {
    playbackMode = mode;
    savePlaybackMode(mode);
    syncAllModeUi();
  }

  function cyclePlaybackMode() {
    const index = MODES.indexOf(playbackMode);
    const next = MODES[(index + 1) % MODES.length];
    setPlaybackMode(next);
  }

  function stopOthers(except: HTMLAudioElement) {
    document.querySelectorAll<HTMLAudioElement>('[data-beat-audio]').forEach((audio) => {
      if (audio !== except && !audio.paused) {
        audio.pause();
      }
    });
    getPlayers().forEach((player) => {
      const audio = player.querySelector<HTMLAudioElement>('[data-beat-audio]');
      if (audio && audio !== except) {
        player.classList.remove('is-playing');
        const btn = player.querySelector<HTMLButtonElement>('[data-beat-play]');
        if (btn) {
          const title = audio.getAttribute('aria-label')?.replace(/^Audio for /, '') ?? 'track';
          btn.setAttribute('aria-label', `Play ${title}`);
        }
      }
    });
  }

  async function playPlayer(player: HTMLElement) {
    const audio = player.querySelector<HTMLAudioElement>('[data-beat-audio]');
    if (!audio) return;
    stopOthers(audio);
    audio.currentTime = 0;
    try {
      await audio.play();
    } catch (err) {
      console.error('Failed to play audio:', err);
    }
  }

  async function playNextInQueue(current: HTMLElement) {
    const players = getPlayers();
    if (players.length === 0) return;
    const index = players.indexOf(current);
    if (index < 0) return;
    const next = players[(index + 1) % players.length];
    // Single-track page: queue wraps to the same player (same as repeat).
    await playPlayer(next);
  }

  function bindPlayer(player: HTMLElement) {
    if (player.dataset.bound === 'true') return;
    player.dataset.bound = 'true';

    const audio = player.querySelector<HTMLAudioElement>('[data-beat-audio]');
    const playBtn = player.querySelector<HTMLButtonElement>('[data-beat-play]');
    const modeBtn = player.querySelector<HTMLButtonElement>('[data-beat-mode]');
    const seek = player.querySelector<HTMLInputElement>('[data-beat-seek]');
    const currentEl = player.querySelector<HTMLElement>('[data-beat-current]');
    const durationEl = player.querySelector<HTMLElement>('[data-beat-duration]');
    if (!audio || !playBtn || !modeBtn || !seek || !currentEl || !durationEl) return;

    const title = audio.getAttribute('aria-label')?.replace(/^Audio for /, '') ?? 'track';
    let seeking = false;

    const syncPlayState = () => {
      const playing = !audio.paused;
      player.classList.toggle('is-playing', playing);
      playBtn.setAttribute('aria-label', playing ? `Pause ${title}` : `Play ${title}`);
    };

    const syncTime = () => {
      currentEl.textContent = formatTime(audio.currentTime);
      if (!seeking && Number.isFinite(audio.duration) && audio.duration > 0) {
        seek.value = String(Math.round((audio.currentTime / audio.duration) * SEEK_MAX));
      }
    };

    const syncDuration = () => {
      durationEl.textContent = formatTime(audio.duration);
    };

    const resetToStart = () => {
      seek.value = '0';
      currentEl.textContent = '0:00';
      audio.currentTime = 0;
    };

    playBtn.addEventListener('click', async (event) => {
      event.preventDefault();
      event.stopPropagation();
      if (audio.paused) {
        stopOthers(audio);
        try {
          await audio.play();
        } catch (err) {
          console.error('Failed to play audio:', err);
        }
      } else {
        audio.pause();
      }
      syncPlayState();
    });

    modeBtn.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      cyclePlaybackMode();
    });

    seek.addEventListener('pointerdown', () => {
      seeking = true;
    });
    seek.addEventListener('pointerup', () => {
      seeking = false;
    });
    seek.addEventListener('input', () => {
      if (!Number.isFinite(audio.duration) || audio.duration <= 0) return;
      const ratio = Number(seek.value) / SEEK_MAX;
      audio.currentTime = ratio * audio.duration;
      currentEl.textContent = formatTime(audio.currentTime);
    });

    audio.addEventListener('play', syncPlayState);
    audio.addEventListener('pause', syncPlayState);
    audio.addEventListener('ended', () => {
      syncPlayState();

      if (playbackMode === 'repeat') {
        void (async () => {
          resetToStart();
          try {
            await audio.play();
          } catch (err) {
            console.error('Failed to repeat audio:', err);
          }
        })();
        return;
      }

      if (playbackMode === 'queue') {
        void playNextInQueue(player);
        return;
      }

      // once
      resetToStart();
    });
    audio.addEventListener('timeupdate', syncTime);
    audio.addEventListener('loadedmetadata', () => {
      syncDuration();
      syncTime();
    });

    if (audio.readyState >= 1) {
      syncDuration();
      syncTime();
    }
    syncPlayState();
    syncModeUi(player);
  }

  function bindAllPlayers() {
    playbackMode = loadPlaybackMode();
    document.querySelectorAll<HTMLElement>('[data-beat-player]').forEach(bindPlayer);
    syncAllModeUi();
  }

  bindAllPlayers();
  document.addEventListener('astro:page-load', bindAllPlayers);
</script>

<style>
  .beat-player {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    max-width: 36rem;
    padding: 0.6rem 0.85rem;
    background: var(--color-bg-card, var(--sl-color-gray-6));
    border: 1px solid var(--color-border, var(--sl-color-gray-5));
    border-radius: var(--radius-md, 0.5rem);
  }

  .beat-audio {
    display: none;
  }

  .beat-play-btn {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    color: #fff;
    background: var(--color-accent, #4285f4);
    border: none;
    border-radius: 999px;
    cursor: pointer;
    transition: background 150ms ease, transform 150ms ease;
  }

  .beat-play-btn:hover {
    background: var(--color-accent-hover, #5a9bff);
  }

  .beat-play-btn:active {
    transform: scale(0.96);
  }

  .beat-play-icon {
    display: grid;
    place-items: center;
    width: 1.125rem;
    height: 1.125rem;
  }

  .beat-play-icon svg {
    grid-area: 1 / 1;
    display: block;
    width: 1.125rem;
    height: 1.125rem;
    max-width: none;
  }

  .beat-play-icon .icon-play {
    /* Triangle reads left-heavy; nudge for optical center */
    transform: translateX(1px);
  }

  .beat-play-icon .icon-pause {
    opacity: 0;
  }

  .beat-player.is-playing .beat-play-icon .icon-play {
    opacity: 0;
  }

  .beat-player.is-playing .beat-play-icon .icon-pause {
    opacity: 1;
  }

  .beat-seek {
    flex: 1;
    min-width: 0;
    height: 0.35rem;
    margin: 0;
    cursor: pointer;
    appearance: none;
    background: transparent;
  }

  .beat-seek::-webkit-slider-runnable-track {
    height: 0.35rem;
    background: var(--color-border-hover, var(--sl-color-gray-4));
    border-radius: 999px;
  }

  .beat-seek::-webkit-slider-thumb {
    appearance: none;
    width: 0.85rem;
    height: 0.85rem;
    margin-top: -0.25rem;
    background: var(--color-accent, #4285f4);
    border: none;
    border-radius: 999px;
  }

  .beat-seek::-moz-range-track {
    height: 0.35rem;
    background: var(--color-border-hover, var(--sl-color-gray-4));
    border-radius: 999px;
  }

  .beat-seek::-moz-range-thumb {
    width: 0.85rem;
    height: 0.85rem;
    background: var(--color-accent, #4285f4);
    border: none;
    border-radius: 999px;
  }

  .beat-time {
    display: flex;
    flex-shrink: 0;
    gap: 0.2rem;
    min-width: 5.5rem;
    justify-content: flex-end;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted, var(--sl-color-gray-3));
  }

  .beat-time-sep {
    opacity: 0.7;
  }

  .beat-mode-btn {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    padding: 0;
    color: var(--color-text-muted, var(--sl-color-gray-3));
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-md, 0.5rem);
    cursor: pointer;
    transition: color 150ms ease, background 150ms ease, border-color 150ms ease;
  }

  .beat-mode-btn:hover {
    color: var(--sl-color-accent);
    background: color-mix(in srgb, var(--sl-color-accent) 12%, transparent);
  }

  .beat-mode-btn[data-mode='repeat'],
  .beat-mode-btn[data-mode='queue'] {
    color: var(--sl-color-accent);
  }

  .beat-mode-icon {
    display: grid;
    place-items: center;
    width: 1.125rem;
    height: 1.125rem;
  }

  .beat-mode-icon svg {
    grid-area: 1 / 1;
    display: block;
    width: 1.125rem;
    height: 1.125rem;
    max-width: none;
    opacity: 0;
  }

  .beat-mode-btn[data-mode='once'] .icon-mode-once,
  .beat-mode-btn:not([data-mode]) .icon-mode-once {
    opacity: 1;
  }

  .beat-mode-btn[data-mode='repeat'] .icon-mode-repeat {
    opacity: 1;
  }

  .beat-mode-btn[data-mode='queue'] .icon-mode-queue {
    opacity: 1;
  }
</style>
