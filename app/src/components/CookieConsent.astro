---
/**
 * Cookie Consent Banner - GDPR compliant cookie consent for Google Analytics
 * 
 * - Shows banner on first visit (no consent stored) and when reopened from the footer
 * - src/lib/consent.ts stores the choice and starts or stops Google Analytics
 * - Bilingual support (English/Japanese based on URL path)
 */

const isJapanese = Astro.url.pathname.startsWith('/ja/') || Astro.url.pathname === '/ja';

const labels = isJapanese
  ? {
      message: 'このサイトでは、サイトの利用状況を分析するために Cookie を使用しています。',
      learnMore: 'プライバシーポリシー',
      accept: '同意する',
      reject: '拒否する',
    }
  : {
      message: 'We use cookies to analyze site usage and improve your experience.',
      learnMore: 'Privacy Policy',
      accept: 'Accept',
      reject: 'Decline',
    };

const privacyPolicyUrl = isJapanese ? '/ja/privacy-policy/' : '/privacy-policy/';
---

<div id="cookie-consent-banner" class="cookie-banner" role="dialog" aria-labelledby="cookie-consent-title" tabindex="-1" hidden>
  <div class="cookie-content">
    <p id="cookie-consent-title" class="cookie-message">
      {labels.message}{isJapanese ? '' : ' '}<a href={privacyPolicyUrl} class="cookie-link">{labels.learnMore}</a>
    </p>
    <div class="cookie-actions">
      <button id="cookie-reject" class="cookie-button cookie-button-secondary" type="button">
        {labels.reject}
      </button>
      <button id="cookie-accept" class="cookie-button cookie-button-primary" type="button">
        {labels.accept}
      </button>
    </div>
  </div>
</div>

<script>
  import { choose, watchBanner } from '../lib/consent';

  const banner = document.getElementById('cookie-consent-banner');
  let returnFocus: HTMLElement | null = null;

  watchBanner((state) => {
    if (!banner) return;
    banner.hidden = state === 'hidden';
    if (state === 'reviewing') {
      returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      banner.focus();
    } else if (state === 'hidden' && returnFocus?.isConnected) {
      returnFocus.focus();
      returnFocus = null;
    }
  });

  document.getElementById('cookie-accept')?.addEventListener('click', () => choose('granted'));
  document.getElementById('cookie-reject')?.addEventListener('click', () => choose('denied'));
</script>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    background: var(--site-bg);
    border-top: 1px solid var(--site-faint);
    padding: 1rem;
  }

  .cookie-content {
    max-width: 72rem;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .cookie-message {
    flex: 1;
    min-width: 280px;
    margin: 0;
    font-size: 0.875rem;
    color: var(--site-text);
    line-height: 1.5;
  }

  .cookie-link {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    text-decoration-color: color-mix(in srgb, currentColor 65%, transparent);
  }

  .cookie-link:hover {
    text-decoration-thickness: 2px;
    text-decoration-color: currentColor;
  }

  .cookie-actions {
    display: flex;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .cookie-button {
    padding: 0.5rem 1rem;
    border-radius: 6px;
    border: 1px solid var(--site-faint);
    background: transparent;
    color: var(--site-text);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .cookie-button-primary {
    color: var(--site-fg);
    border-color: color-mix(in srgb, var(--site-fg) 55%, transparent);
    background: color-mix(in srgb, var(--site-fg) 6%, transparent);
  }

  .cookie-button:hover {
    color: var(--site-fg);
  }

  .cookie-button-secondary:hover {
    border-color: var(--site-muted);
  }

  .cookie-button-primary:hover {
    border-color: var(--site-fg);
  }

  @media (prefers-reduced-motion: reduce) {
    .cookie-button {
      transition: none;
    }
  }

  @media (max-width: 600px) {
    .cookie-content {
      flex-direction: column;
      text-align: center;
    }

    .cookie-actions {
      width: 100%;
      justify-content: center;
    }

    .cookie-button {
      flex: 1;
      max-width: 150px;
    }
  }
</style>

