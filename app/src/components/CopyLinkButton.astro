---
/**
 * CopyLinkButton — copies a URL to the clipboard with a short "Copied" state.
 */
interface Props {
  url: string;
  /** Visible label; defaults to "Copy link" */
  label?: string;
}

const { url, label = 'Copy link' } = Astro.props;
---

<button
  type="button"
  class="copy-link-button not-content"
  data-url={url}
  data-label={label}
  data-copied-label="Copied!"
  aria-label={label}
>
  <span class="copy-link-icon" aria-hidden="true">
    <svg
      class="icon-link"
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
    </svg>
    <svg
      class="icon-check"
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M20 6 9 17l-5-5"></path>
    </svg>
  </span>
  <span class="copy-link-label">{label}</span>
</button>

<script>
  function bindCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>('.copy-link-button').forEach((btn) => {
      if (btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';

      btn.addEventListener('click', async () => {
        const targetUrl = btn.getAttribute('data-url');
        if (!targetUrl) return;

        const labelEl = btn.querySelector<HTMLElement>('.copy-link-label');
        const defaultLabel = btn.getAttribute('data-label') ?? 'Copy link';
        const copiedLabel = btn.getAttribute('data-copied-label') ?? 'Copied!';

        try {
          await navigator.clipboard.writeText(targetUrl);
          btn.classList.add('copied');
          if (labelEl) labelEl.textContent = copiedLabel;
          window.setTimeout(() => {
            btn.classList.remove('copied');
            if (labelEl) labelEl.textContent = defaultLabel;
          }, 2000);
        } catch (err) {
          console.error('Failed to copy URL:', err);
        }
      });
    });
  }

  bindCopyButtons();
  document.addEventListener('astro:page-load', bindCopyButtons);
</script>

<style>
  .copy-link-button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.7rem;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1;
    color: var(--sl-color-gray-2);
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--radius-md, 0.5rem);
    cursor: pointer;
    transition: background 150ms ease, border-color 150ms ease, color 150ms ease;
  }

  .copy-link-button:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-5);
    border-color: var(--sl-color-gray-4);
  }

  .copy-link-icon {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .copy-link-icon svg {
    grid-area: 1 / 1;
    display: block;
    width: 1rem;
    height: 1rem;
    max-width: none;
  }

  .copy-link-icon .icon-check {
    color: var(--color-success, #34a853);
    opacity: 0;
  }

  .copy-link-button.copied .icon-link {
    opacity: 0;
  }

  .copy-link-button.copied .icon-check {
    opacity: 1;
  }

  .copy-link-label {
    display: inline-block;
    line-height: 1rem;
  }

  .copy-link-button.copied {
    background: rgba(52, 168, 83, 0.15);
    border-color: var(--color-success, #34a853);
  }
</style>
