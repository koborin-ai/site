---
interface Props {
  title: string;
  description: string;
  lang: 'en' | 'ja';
  ogImage?: string;
  hreflang?: { hreflang: string; href: string }[];
}

const { title, description, lang, ogImage, hreflang = [] } = Astro.props;

const normalizeToWebp = (path: string) => path.replace(/\.(png|jpe?g)$/i, '.webp');
const ogImagePath = ogImage ? normalizeToWebp(ogImage) : '/og/index.webp';
const ogImageUrl = new URL(ogImagePath, Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const pageTitle = `${title} | koborin.ai`;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{hreflang.map((link) => (
  <link rel="alternate" hreflang={link.hreflang} href={link.href} />
))}
<link rel="shortcut icon" href="/favicon.png" type="image/png" />

<meta property="og:title" content={title} />
<meta property="og:type" content="article" />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={lang} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="koborin.ai" />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImageUrl} />

<link rel="alternate" type="application/rss+xml" title="koborin.ai" href="/rss.xml" />
<link rel="alternate" type="application/rss+xml" title="koborin.ai (日本語)" href="/ja/rss.xml" />

{gaMeasurementId && <meta name="ga-measurement-id" content={gaMeasurementId} />}
<script>
    const measurementId = document.querySelector('meta[name="ga-measurement-id"]')?.getAttribute('content');
    const storageKey = 'cookie_consent';
    const consentAccepted = 'accepted';

    type AnalyticsWindow = Window & {
      ga4Loaded?: boolean;
      dataLayer?: unknown[];
      gtag?: (...args: unknown[]) => void;
    };

    const analytics = window as AnalyticsWindow;

    function hasAcceptedCookies(): boolean {
      try {
        return localStorage.getItem(storageKey) === consentAccepted;
      } catch {
        return false;
      }
    }

    function gtag(..._args: unknown[]): void {
      analytics.dataLayer?.push(arguments);
    }

    function loadGA4(): void {
      if (!measurementId || analytics.ga4Loaded) return;
      analytics.ga4Loaded = true;

      const script = document.createElement('script');
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtag/js?id=' + measurementId;
      document.head.appendChild(script);

      analytics.dataLayer = analytics.dataLayer || [];
      analytics.gtag = gtag;
      gtag('js', new Date());
      gtag('config', measurementId);
    }

    if (hasAcceptedCookies()) loadGA4();

    window.addEventListener('cookie-consent-changed', (event) => {
      const detail = (event as CustomEvent<{ consent?: string }>).detail;
      if (detail?.consent === consentAccepted) loadGA4();
    });

    document.addEventListener('astro:page-load', () => {
      if (hasAcceptedCookies() && !analytics.ga4Loaded) loadGA4();
    });
</script>
