---
import { getCollection } from 'astro:content';
import SiteImage from './SiteImage.astro';
import QuietList from './QuietList.astro';
import TerraDartMark from './TerraDartMark.astro';
import ContextlintMark from './ContextlintMark.astro';
import bookCover from '../assets/life/reflections-on-2025/book-cover.png';
import {
  bio,
  book,
  homeLimit,
  linkLabel,
  listHref,
  projects,
  sections,
  talks,
  writingPosts,
} from '../lib/catalog';
import type { Locale } from '../lib/docs';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const docs = await getCollection('docs');
const posts = writingPosts(docs, locale).slice(0, homeLimit);
const latestTalks = talks.slice(0, homeLimit);
---

<h1 class="name">Nozomi Koborinai</h1>
<p class="bio">
  {bio[locale].before}
  <a class="badge" href="https://terradart.dev/">
    <TerraDartMark />
    TerraDart
  </a>
  {bio[locale].after}
</p>
<a class="book" href={book.href}>
  <SiteImage
    src={bookCover}
    alt=""
    variant="thumbnail"
    widths={[64, 128]}
    sizes="40px"
    loading="eager"
    class="book-badge"
    style="height: 2.5rem; width: auto; border-radius: 2px;"
  />
  <span>{book.title}</span>
</a>
<p class="book-note">{book.note[locale]}</p>

<h2 class="section-label">{sections.building[locale]}</h2>
<ul class="quiet-list">
  {projects.map((project) => (
    <li>
      <a class="project" href={project.href} target="_blank" rel="noopener noreferrer">
        <span class="project-name">
          {project.mark === 'contextlint' && <ContextlintMark />}
          {project.name}
        </span>
        <span class="link-label">{linkLabel[project.kind][locale]}</span>
        <span class="project-desc">{project.description[locale]}</span>
      </a>
    </li>
  ))}
</ul>

<h2 class="section-label">{sections.writing[locale]}</h2>
<QuietList items={posts.map((post) => ({ title: post.title, href: post.href, date: post.dateLabel }))} />
<a class="more" href={listHref('writing', locale)}>{linkLabel.all[locale]}</a>

<h2 class="section-label">{sections.talks[locale]}</h2>
<QuietList
  items={latestTalks.map((item) => ({
    title: item.title[locale],
    meta: item.event[locale],
    date: item.date,
    href: item.href,
    external: item.href !== undefined,
  }))}
/>
<a class="more" href={listHref('talks', locale)}>{linkLabel.all[locale]}</a>
