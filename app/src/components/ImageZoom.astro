---
// ImageZoom component - Enables click-to-zoom for images and Mermaid diagrams
---

<script>
  import mediumZoom from 'medium-zoom';

  function initZoom() {
    // Initialize medium-zoom for content images, excluding images wrapped in
    // <a> (linked images should follow the link instead of zooming).
    const candidates = document.querySelectorAll<HTMLImageElement>(
      '.sl-markdown-content img:not(.medium-zoom-image)'
    );
    const zoomable = Array.from(candidates).filter(
      (img) => !img.closest('a') && !img.classList.contains('no-zoom')
    );
    mediumZoom(zoomable, {
      margin: 24,
      background: 'rgba(0, 0, 0, 0.9)',
      scrollOffset: 0,
    });

    // Custom zoom for Mermaid SVG diagrams only (never UI icons like play buttons)
    initMermaidZoom();
  }

  function initMermaidZoom() {
    const mermaidSvgs = document.querySelectorAll(
      '.sl-markdown-content svg[id^="mermaid"]'
    );

    mermaidSvgs.forEach((svg) => {
      // Skip if already processed
      if (svg.hasAttribute('data-zoomable')) return;
      svg.setAttribute('data-zoomable', 'true');

      svg.addEventListener('click', () => {
        openSvgModal(svg as SVGElement);
      });
    });
  }

  function openSvgModal(svg: SVGElement) {
    // Create modal overlay
    const overlay = document.createElement('div');
    overlay.className = 'svg-zoom-overlay';
    
    // Clone SVG for modal display
    const svgClone = svg.cloneNode(true) as SVGElement;
    svgClone.classList.add('svg-zoom-content');
    svgClone.removeAttribute('data-zoomable');
    
    overlay.appendChild(svgClone);
    document.body.appendChild(overlay);
    
    // Prevent body scroll
    document.body.style.overflow = 'hidden';
    
    // Animate in
    requestAnimationFrame(() => {
      overlay.classList.add('active');
    });
    
    // Close on click or ESC
    const close = () => {
      overlay.classList.remove('active');
      setTimeout(() => {
        overlay.remove();
        document.body.style.overflow = '';
      }, 200);
    };
    
    overlay.addEventListener('click', close);
    
    const handleKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        close();
        document.removeEventListener('keydown', handleKeydown);
      }
    };
    document.addEventListener('keydown', handleKeydown);
  }

  // Initialize on page load
  document.addEventListener('astro:page-load', initZoom);

  // Also run on initial load for non-SPA navigation
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initZoom);
  } else {
    initZoom();
  }
</script>

<style is:global>
  /* medium-zoom does not set z-index, so the zoomed image would sit under the fixed header. */
  .medium-zoom-overlay,
  .medium-zoom-image--opened {
    z-index: 1000;
  }

  [data-zoomable] {
    cursor: zoom-in;
  }

  .svg-zoom-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px;
    overflow: auto;
    background: rgba(0, 0, 0, 0);
    cursor: zoom-out;
    opacity: 0;
    transition: background 200ms ease, opacity 200ms ease;
  }

  .svg-zoom-overlay.active {
    background: rgba(0, 0, 0, 0.9);
    opacity: 1;
  }

  .svg-zoom-content {
    width: auto;
    max-width: 95vw;
    height: auto;
    max-height: 90vh;
    padding: 24px;
    border: 1px solid var(--site-faint);
    border-radius: var(--prose-radius);
    background: var(--diagram-surface);
    transform: scale(0.9);
    transition: transform 200ms ease;
    touch-action: pan-x pan-y pinch-zoom;
  }

  .svg-zoom-overlay.active .svg-zoom-content {
    transform: scale(1);
  }

  @media (max-width: 768px) {
    .svg-zoom-overlay {
      padding: 12px;
    }

    .svg-zoom-content {
      max-width: 100vw;
      max-height: 85vh;
      padding: 12px;
    }
  }
</style>

