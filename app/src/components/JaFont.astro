<script is:inline>
  window.addEventListener('load', () => {
    setTimeout(() => fetch('/fonts/noto-sans-jp.css')
      .then((response) => response.text())
      .then((css) => {
        const pattern = /font-weight:\s*(\d+);[\s\S]*?url\("([^"]+)"\)[\s\S]*?unicode-range:\s*([^;]+);/g;
        for (const match of css.matchAll(pattern)) {
          const face = new FontFace('Noto Sans JP', `url("${match[2]}")`, {
            weight: match[1],
            style: 'normal',
            unicodeRange: match[3].trim(),
            display: 'swap',
          });
          document.fonts.add(face);
          face.load();
        }
      })
      .catch(() => undefined), 0);
  });
</script>
