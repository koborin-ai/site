---
import { getCollection } from 'astro:content';
import QuietList from './QuietList.astro';
import TalkList from './TalkList.astro';
import SiteShell from './SiteShell.astro';
import Footer from './Footer.astro';
import { groupByYear, listHreflang, listHref, listMeta, talks, writingPosts, type ListKind } from '../lib/catalog';
import type { Locale } from '../lib/docs';

interface Props {
  kind: ListKind;
  locale: Locale;
}

const { kind, locale } = Astro.props;
const meta = listMeta[kind][locale];
const enHref = listHref(kind, 'en');
const jaHref = listHref(kind, 'ja');
const postGroups = kind === 'writing'
  ? groupByYear(writingPosts(await getCollection('docs'), locale))
  : [];
const talkGroups = kind === 'talks' ? groupByYear(talks) : [];
---

<SiteShell
  locale={locale}
  title={meta.title}
  description={meta.description}
  enHref={enHref}
  jaHref={jaHref}
  hreflang={listHreflang(kind, Astro.site?.href ?? 'https://koborin.ai')}
>
  <a class="back" href={locale === 'ja' ? '/ja/' : '/'}>← koborin.ai</a>
  <h1 class="list-title">{meta.title}</h1>
  {kind === 'writing' && postGroups.map((group) => (
    <section class="year">
      <h2>{group.year}</h2>
      <QuietList items={group.items.map((item) => ({ title: item.title, href: item.href, date: item.monthDay }))} />
    </section>
  ))}
  {kind === 'talks' && talkGroups.map((group) => (
    <section class="year">
      <h2>{group.year}</h2>
      <TalkList talks={group.items} locale={locale} where="list" />
    </section>
  ))}
  <Footer title={meta.title} showEngagement={false} />
</SiteShell>
