---
import { shouldShowUpdated } from '../lib/last-updated';
import type { Locale } from '../lib/docs';

interface Props {
  title: string;
  locale: Locale;
  publishedAt?: Date;
  updatedAt?: Date;
  draft?: boolean;
}

const { title, locale, publishedAt, updatedAt, draft = false } = Astro.props;
const showUpdated = shouldShowUpdated(publishedAt, updatedAt);

function formatDate(date: Date, lang: Locale): string {
  if (lang === 'ja') {
    return date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
  }
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

const labels = locale === 'ja'
  ? { published: '公開', updated: '更新', draft: 'このコンテンツは下書きです。プロダクションビルドには含まれません。' }
  : { published: 'Published', updated: 'Updated', draft: 'This content is a draft and will not be included in production builds.' };
---

<h1 class="page-title">{title}</h1>

{(publishedAt || showUpdated) && (
  <div class="article-dates">
    {publishedAt && (
      <span class="date-item">
        <span class="date-label">{labels.published}:</span>
        <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt, locale)}</time>
      </span>
    )}
    {publishedAt && showUpdated && updatedAt && <span class="date-separator">·</span>}
    {showUpdated && updatedAt && (
      <span class="date-item">
        <span class="date-label">{labels.updated}:</span>
        <time datetime={updatedAt.toISOString()}>{formatDate(updatedAt, locale)}</time>
      </span>
    )}
  </div>
)}

{draft && <p class="draft-notice">{labels.draft}</p>}

<style>
  .article-dates {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-size: 0.875rem;
  }

  .date-item {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
</style>
