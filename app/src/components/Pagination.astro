---
import type { Locale } from '../lib/docs';
import type { Neighbor } from '../lib/navigation';

interface Props {
  locale: Locale;
  prev?: Neighbor;
  next?: Neighbor;
}

const { locale, prev, next } = Astro.props;
const labels = locale === 'ja'
  ? { prev: '前へ', next: '次へ' }
  : { prev: 'Previous', next: 'Next' };
---

{(prev || next) && (
  <nav class="pagination" aria-label={locale === 'ja' ? 'ページ移動' : 'Pagination'}>
    {prev ? (
      <a href={prev.href} rel="prev">
        <span>{labels.prev}</span>
        <span>{prev.label}</span>
      </a>
    ) : <span></span>}
    {next && (
      <a class="pagination-next" href={next.href} rel="next">
        <span>{labels.next}</span>
        <span>{next.label}</span>
      </a>
    )}
  </nav>
)}

<style>
  .pagination a {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    max-width: 45%;
  }

  .pagination a span:first-child {
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
  }
</style>
