---
interface Item {
  href: string;
  title: string;
  date: string;
}

interface Props {
  items: readonly Item[];
}

const { items } = Astro.props;
---

<ul class="quiet-list">
  {items.map((item) => (
    <li>
      <a class="row" href={item.href}>
        <span class="link-text">{item.title}</span>
      </a>
      <span class="meta">{item.date}</span>
    </li>
  ))}
</ul>
