---
interface Item {
  href?: string;
  title: string;
  meta?: string;
  date: string;
  external?: boolean;
}

interface Props {
  items: readonly Item[];
}

const { items } = Astro.props;
---

<ul class="quiet-list">
  {items.map((item) => (
    <li>
      {item.href ? (
        <a
          class="quiet-row"
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
        >
          <span class="entry-title">{item.title}</span>
          <time class="entry-date">{item.date}</time>
          {item.meta && <span class="entry-meta">{item.meta}</span>}
        </a>
      ) : (
        <div class="quiet-row">
          <span class="entry-title">{item.title}</span>
          <time class="entry-date">{item.date}</time>
          {item.meta && <span class="entry-meta">{item.meta}</span>}
        </div>
      )}
    </li>
  ))}
</ul>
