---
import icons from '../data/site-icons.json';
import { siteHostname } from '../lib/site-icon';

interface Props {
  href: string;
  title?: string;
  description?: string;
}

const { href, title, description } = Astro.props;
const isExternal = /^https?:\/\//i.test(href);
const domain = siteHostname(href, Astro.site);
const icon = (icons as Record<string, string>)[domain];

async function fetchOgText(target: string): Promise<{ title?: string; description?: string } | null> {
  try {
    const response = await fetch(target, {
      headers: {
        'User-Agent': 'Mozilla/5.0 (compatible; AstroBot/1.0)',
      },
    });
    if (!response.ok) return null;

    const html = await response.text();
    const ogTitle = html.match(/<meta[^>]*property=["']og:title["'][^>]*content=["']([^"']+)["']/i)?.[1]
      || html.match(/<meta[^>]*content=["']([^"']+)["'][^>]*property=["']og:title["']/i)?.[1]
      || html.match(/<title[^>]*>([^<]+)<\/title>/i)?.[1];
    const ogDescription = html.match(/<meta[^>]*property=["']og:description["'][^>]*content=["']([^"']+)["']/i)?.[1]
      || html.match(/<meta[^>]*content=["']([^"']+)["'][^>]*property=["']og:description["']/i)?.[1]
      || html.match(/<meta[^>]*name=["']description["'][^>]*content=["']([^"']+)["']/i)?.[1];

    return { title: ogTitle, description: ogDescription };
  } catch {
    return null;
  }
}

const og = isExternal && (!title || !description) ? await fetchOgText(href) : null;
const displayTitle = title || og?.title || domain;
const displayDescription = description || og?.description;
---

<a
  href={href}
  class="rich-link-card"
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
>
  <span class="title">{displayTitle}</span>
  {displayDescription && <span class="description">{displayDescription}</span>}
  <span class="source">
    {icon && <img src={icon} alt="" width="14" height="14" aria-hidden="true" />}
    {domain}
  </span>
</a>

<style>
  .rich-link-card {
    display: block;
    padding: 14px 18px;
    border: 1px solid var(--site-faint);
    border-radius: var(--prose-radius);
    background: transparent;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .rich-link-card:hover,
  .rich-link-card:focus-visible {
    border-color: var(--site-muted);
  }

  .rich-link-card + .rich-link-card {
    margin-top: 10px;
  }

  .title {
    display: block;
    color: var(--site-fg);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.5;
  }

  .description {
    display: -webkit-box;
    margin-top: 2px;
    overflow: hidden;
    color: var(--prose-secondary);
    font-size: 13px;
    line-height: 1.6;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .source {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    color: var(--site-muted);
    font-family: var(--prose-mono);
    font-size: 12px;
    line-height: 1.4;
  }

  .source img {
    width: 14px;
    height: 14px;
    flex: none;
    filter: grayscale(1);
    opacity: 0.55;
    transition: filter 0.15s ease, opacity 0.15s ease;
  }

  .rich-link-card:hover .source img,
  .rich-link-card:focus-visible .source img {
    filter: none;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .rich-link-card,
    .source img {
      transition: none;
    }
  }
</style>
