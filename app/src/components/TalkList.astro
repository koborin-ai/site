---
import { formatTalkDate, type Talk, type TalkKind } from '../lib/catalog';
import type { Locale } from '../lib/docs';

interface Props {
  talks: readonly Talk[];
  locale: Locale;
  where: 'home' | 'list';
}

const { talks, locale, where } = Astro.props;

const kindLabel: Record<TalkKind, Record<Locale, string>> = {
  video: { en: 'Video', ja: '動画' },
  slides: { en: 'Slides', ja: 'スライド' },
  event: { en: 'Event', ja: 'イベント' },
  repo: { en: 'Repo', ja: 'リポジトリ' },
};

function countLabel(count: number): string {
  return locale === 'en' ? `${count} people` : `${count} 人`;
}

function meta(talk: Talk): string {
  return [
    formatTalkDate(talk.date, where, locale),
    where === 'list' && talk.attendees !== undefined ? countLabel(talk.attendees) : undefined,
    talk.link ? kindLabel[talk.link.kind][locale] : undefined,
  ]
    .filter((part) => part !== undefined)
    .join(' · ');
}
---

<ul class="quiet-list">
  {talks.map((talk) => (
    <li>
      {talk.link ? (
        <a class="row" href={talk.link.href} target="_blank" rel="noopener noreferrer">
          <span class="link-text">{talk.title[locale]}</span>
          <span class="sub">{talk.event[locale]}</span>
        </a>
      ) : (
        <span class="t">
          {talk.title[locale]}
          <span class="sub">{talk.event[locale]}</span>
        </span>
      )}
      <span class="meta">{meta(talk)}</span>
    </li>
  ))}
</ul>
