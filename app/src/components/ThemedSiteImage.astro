---
/**
 * Both images use loading="lazy". A display:none image is not fetched.
 */
import SiteImage from './SiteImage.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  lightSrc: ImageMetadata;
  darkSrc: ImageMetadata;
  alt: string;
  variant: 'hero';
  wrapperClass?: string;
}

const { lightSrc, darkSrc, alt, variant, wrapperClass = 'hero-image' } = Astro.props;
---

<div class={wrapperClass}>
  <SiteImage
    src={lightSrc}
    alt={alt}
    variant={variant}
    class="hero-light"
    loading="lazy"
    fetchpriority="high"
  />
  <SiteImage
    src={darkSrc}
    alt={alt}
    variant={variant}
    class="hero-dark"
    loading="lazy"
    fetchpriority="auto"
  />
</div>
