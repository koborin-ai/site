{
  "name": "jev-spec",
  "version": "0.1.0",
  "description": "Specification-Driven Semantic Verification Engine for AI Code & Specs powered by TypeSafe AI Jev",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "jev-spec": "./bin/jev-spec.js"
  },
  "scripts": {
    "build": "/workspace/app/node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "node --test 'dist-test/test/**/*.test.js'",
    "pretest": "/workspace/app/node_modules/typescript/bin/tsc -p tsconfig.json && /workspace/app/node_modules/typescript/bin/tsc -p tsconfig.test.json",
    "check": "/workspace/app/node_modules/typescript/bin/tsc -p tsconfig.json --noEmit && /workspace/app/node_modules/typescript/bin/tsc -p tsconfig.test.json --noEmit"
  },
  "keywords": [
    "typesafe-ai",
    "jev",
    "sdd",
    "specification-driven-development",
    "semantic-verification",
    "linter"
  ],
  "author": "Nozomi Koborinai",
  "license": "MIT",
  "devDependencies": {
    "@types/micromatch": "^4.0.10",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@types/mdast": "^4.0.4",
    "@typesafe-ai/sdk": "^0.6.0",
    "fast-glob": "^3.3.3",
    "jiti": "^2.7.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.1.2",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "micromatch": "^4.0.8",
    "unist-util-visit": "^5.1.0"
  }
}
